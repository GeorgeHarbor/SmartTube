<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube color scheme: fades the featured video picture into the background (left and bottom edges) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#FF0F0F0F" android:centerColor="#990F0F0F" android:endColor="#000F0F0F"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#FF0F0F0F" android:centerColor="#400F0F0F" android:endColor="#000F0F0F"/>
        </shape>
    </item>
</layer-list>
