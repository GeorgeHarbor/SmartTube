<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube color scheme: dialog item is a grey pill, the focused one turns white -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="#F1F1F1" />
                <corners android:radius="24dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/scheme_youtube_thumbnail" />
                <corners android:radius="24dp" />
            </shape>
        </inset>
    </item>
</selector>
