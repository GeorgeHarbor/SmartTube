<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube color scheme: channel page header. The banner is drawn behind the rows (see MultipleRowsFragment). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/youtube_channel_info_height"
    android:paddingStart="10dp"
    android:paddingBottom="43dp"
    android:gravity="bottom"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/channel_avatar"
            android:layout_width="@dimen/youtube_channel_avatar_size"
            android:layout_height="@dimen/youtube_channel_avatar_size"
            android:background="@drawable/youtube_channel_avatar"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/channel_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textStyle="bold"
                android:textSize="19sp"
                android:textColor="#F1F1F1" />
            <TextView
                android:id="@+id/channel_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="12.5sp"
                android:textColor="#D9F1F1F1" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/channel_description"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:textSize="14sp"
        android:textColor="#F1F1F1" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/channel_play_mix"
            style="@style/YouTubeChannelButton"
            android:drawableStart="@drawable/youtube_ic_mix"
            android:drawablePadding="6dp"
            android:paddingStart="10dp"
            android:text="@string/channel_play_mix" />
        <TextView
            android:id="@+id/channel_subscribe"
            style="@style/YouTubeChannelButton"
            android:layout_marginStart="11dp" />
    </LinearLayout>
</LinearLayout>
